# PulseChat web app → the SAME Firebase project as the Android app.
# Copy to web/.env (never commit .env) and fill in the config of the *Web app* registered in that
# project: Firebase console → Project settings → General → Your apps → Web app → SDK setup and
# configuration (or `firebase apps:sdkconfig web <WEB_APP_ID>`). See web/README.md, step 1.
#
# These values identify the project; they are not secrets. Access is enforced by Firebase Auth +
# firestore.rules/storage.rules (and App Check, if you enable it). Never put service-account keys here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# Same as pulsechat/app/google-services.json (project_info):
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0426516505
VITE_FIREBASE_MESSAGING_SENDER_ID=677612835092
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0426516505.firebasestorage.app
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0426516505.firebaseapp.com

# Named Firestore database of the Android app (res/values/firebase_applet_config.xml).
VITE_FIRESTORE_DATABASE_ID=ai-studio-android-pulsecha-2c0cef4c-b560-4944-a812-3a390d3cee6a

# Optional: offline cache in IndexedDB.
VITE_FIRESTORE_PERSISTENT_CACHE=false

# Optional: use the local emulators instead of production (run `firebase emulators:start` in pulsechat/).
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
