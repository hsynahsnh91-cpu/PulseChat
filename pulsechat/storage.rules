rules_version = '2';

// PulseChat Cloud Storage security rules.
//
// Uploads are restricted to the authenticated owner's path segment with strict size and MIME limits.
// Reads are never open to arbitrary signed-in users:
// - Direct-chat media (`chat-media/dm_<uidA>_<uidB>/...`) is readable only by the two participants.
// - Group-chat media and group photos require the reader's UID in the object's `participants` metadata.
// - Status media requires the reader's UID in the object's `audience` metadata and must not be expired.
// - Profile photos enforce the owner's `visibility` metadata (`everyone`, `contacts`, `nobody`) and block list.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isUser(userId) { return signedIn() && request.auth.uid == userId; }

    function isDirectParticipant(cid) {
      return signedIn() && (
        cid.matches('^dm_' + request.auth.uid + '_.*')
        || cid.matches('^dm_.*_' + request.auth.uid + '$')
      );
    }

    function hasUidInCsv(csv) {
      return signedIn() && csv is string
        && csv.matches('.*(^|,)' + request.auth.uid + '(,|$).*');
    }

    match /chat-media/{conversationId}/{senderId}/{fileName} {
      allow read: if isUser(senderId)
        || (conversationId.matches('^dm_.*') && isDirectParticipant(conversationId))
        || (!conversationId.matches('^dm_.*')
            && resource.metadata != null
            && 'participants' in resource.metadata
            && hasUidInCsv(resource.metadata.participants));
      allow create: if isUser(senderId)
        && request.resource.size > 0
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.size() > 0
        && request.resource.contentType.size() <= 128
        && (
          (conversationId.matches('^dm_.*') && isDirectParticipant(conversationId))
          || (!conversationId.matches('^dm_.*')
              && request.resource.metadata != null
              && 'participants' in request.resource.metadata
              && hasUidInCsv(request.resource.metadata.participants))
        );
      allow update: if false;
      allow delete: if isUser(senderId);
    }

    match /profile-photos/{userId}/{fileName} {
      allow read: if isUser(userId)
        || (signedIn()
            && (resource.metadata == null || !('blocked' in resource.metadata) || !hasUidInCsv(resource.metadata.blocked))
            && (
              (resource.metadata == null || !('visibility' in resource.metadata) || resource.metadata.visibility == 'everyone')
              || (resource.metadata != null
                  && resource.metadata.get('visibility', 'everyone') == 'contacts'
                  && 'contacts' in resource.metadata
                  && hasUidInCsv(resource.metadata.contacts))
            ));
      allow create, update: if isUser(userId)
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isUser(userId);
    }

    match /group-photos/{conversationId}/{fileName} {
      allow read: if resource.metadata != null
        && 'participants' in resource.metadata
        && hasUidInCsv(resource.metadata.participants);
      allow create, update: if signedIn()
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata != null
        && 'participants' in request.resource.metadata
        && hasUidInCsv(request.resource.metadata.participants);
      allow delete: if signedIn()
        && resource.metadata != null
        && 'participants' in resource.metadata
        && hasUidInCsv(resource.metadata.participants);
    }

    match /group-photos/{conversationId}/{userId}/{fileName} {
      allow read: if isUser(userId)
        || (resource.metadata != null
            && 'participants' in resource.metadata
            && hasUidInCsv(resource.metadata.participants));
      allow create, update: if isUser(userId)
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isUser(userId);
    }

    match /status-media/{userId}/{fileName} {
      allow read: if isUser(userId)
        || (resource.metadata != null
            && 'audience' in resource.metadata
            && hasUidInCsv(resource.metadata.audience)
            && (!('expiresAt' in resource.metadata) || int(resource.metadata.expiresAt) > request.time.toMillis()));
      allow create: if isUser(userId)
        && request.resource.size > 0
        && request.resource.size < 64 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow update: if false;
      allow delete: if isUser(userId);
    }
  }
}
