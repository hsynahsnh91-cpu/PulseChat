# PulseChat build-time configuration template.
# Copy to `.env` for local overrides. `.env` is git-ignored and must never be committed.
#
# SECURITY: PulseChat does NOT embed Gemini credentials in the APK. Gemini is called through
# Firebase AI Logic, where the Gemini API key stays on Google's servers (configure it in the
# Firebase console -> AI Logic). These legacy keys are kept only so the Secrets Gradle Plugin
# configuration keeps working; leave them empty.
GEMINI_API_KEY=
AI_API_KEY=
# Optional App Check debug token for debug builds (ignored by the Secrets plugin, read by AI Studio).
FIREBASE_APPCHECK_DEBUG_TOKEN=
