rules_version = '2';

// PulseChat Firestore security rules.
//
// Every read and write is authorised against the Firebase Auth UID. The Android client mirrors
// these rules (domain/*Policy.kt) only to hide actions the server would reject; this file is the
// real enforcement point. Tests: pulsechat/firebase/rules-tests.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ helpers
    function isDeviceRevoked(userId, deviceId) {
      return deviceId is string && deviceId.size() > 0
        && exists(/databases/$(database)/documents/users/$(userId)/linkedDevices/$(deviceId))
        && get(/databases/$(database)/documents/users/$(userId)/linkedDevices/$(deviceId)).data.status == 'revoked';
    }

    function activeDeviceClaim() {
      let did = request.auth.token.get('linkedDeviceId', null);
      return did == null || !isDeviceRevoked(request.auth.uid, did);
    }

    function signedIn() { return request.auth != null && activeDeviceClaim(); }
    function uid() { return request.auth.uid; }
    function isOwner(userId) { return signedIn() && uid() == userId; }

    function validUsername(n) { return n is string && n.matches('^[a-z][a-z0-9._]{2,19}$'); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 50; }
    function validVisibility(v) { return v in ['everyone', 'contacts', 'nobody']; }
    function validTimer(s) { return s in [0, 86400, 604800, 7776000]; }

    function userData(userId) { return get(/databases/$(database)/documents/users/$(userId)).data; }
    function isContactOf(ownerId) { return exists(/databases/$(database)/documents/users/$(ownerId)/contacts/$(uid())); }
    function hasBlocked(ownerId, otherId) { return exists(/databases/$(database)/documents/users/$(ownerId)/blocked/$(otherId)); }

    // Owner's visibility setting for a profile field ('lastSeenVisibility', 'photoVisibility', 'aboutVisibility').
    function visibilityAllows(ownerId, settingField) {
      let vis = userData(ownerId).get(settingField, 'everyone');
      return uid() == ownerId || vis == 'everyone' || (vis == 'contacts' && isContactOf(ownerId));
    }

    function convPath(cid) { return /databases/$(database)/documents/conversations/$(cid); }
    function isParticipantNow(cid) { return signedIn() && uid() in get(convPath(cid)).data.participants; }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      // Public profile (name, username, 10-digit ID, visibility settings). No photo/about/PII here.
      allow get, list: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'uniqueId10', 'displayName', 'displayNameLower',
             'avatarColorHex', 'lastSeenVisibility', 'photoVisibility', 'aboutVisibility', 'createdAt'])
        && request.resource.data.uid == userId
        && validUsername(request.resource.data.username)
        && request.resource.data.uniqueId10 is string && request.resource.data.uniqueId10.matches('^[1-9][0-9]{9}$')
        && validName(request.resource.data.displayName)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId
        && getAfter(/databases/$(database)/documents/uniqueIds/$(request.resource.data.uniqueId10)).data.uid == userId;

      // Username, ID and creation time are immutable.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'displayNameLower', 'avatarColorHex',
             'lastSeenVisibility', 'photoVisibility', 'aboutVisibility'])
        && validName(request.resource.data.displayName)
        && validVisibility(request.resource.data.get('lastSeenVisibility', 'everyone'))
        && validVisibility(request.resource.data.get('photoVisibility', 'everyone'))
        && validVisibility(request.resource.data.get('aboutVisibility', 'everyone'));

      allow delete: if false;

      // Privacy-controlled profile fields: users/{uid}/restricted/{photo|about}.
      match /restricted/{field} {
        allow get: if signedIn() && field in ['photo', 'about']
          && visibilityAllows(userId, field + 'Visibility')
          && (uid() == userId || !hasBlocked(userId, uid()));
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && field in ['photo', 'about']
          && (field != 'photo' || (request.resource.data.keys().hasOnly(['url', 'updatedAt'])
                && (request.resource.data.url == null || (request.resource.data.url is string && request.resource.data.url.size() < 2048))))
          && (field != 'about' || (request.resource.data.keys().hasOnly(['text', 'updatedAt'])
                && request.resource.data.text is string && request.resource.data.text.size() <= 140));
        allow delete: if isOwner(userId);
      }

      match /contacts/{contactId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && contactId != userId
          && request.resource.data.keys().hasOnly(['nickname', 'addedAt'])
          && (request.resource.data.nickname == null || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 50));
      }
      match /blocked/{blockedId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && blockedId != userId && request.resource.data.keys().hasOnly(['blockedAt']);
      }
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /devices/{deviceId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && !isDeviceRevoked(userId, deviceId)
          && request.resource.data.token is string && request.resource.data.token.size() < 4096;
      }
      // Account-owned linked-device authorization records (distinct from FCM notification tokens).
      match /linkedDevices/{deviceId} {
        function dchanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
        function validDeviceFields(d) {
          return d.keys().hasOnly(['deviceId', 'uid', 'deviceName', 'deviceType', 'platform', 'publicKey', 'keyFingerprint',
               'authMethod', 'status', 'online', 'linkedAt', 'lastActiveAt', 'updatedAt', 'revokedAt', 'revokedByDeviceId',
               'pairedByDeviceId', 'sessionId'])
            && d.deviceId == deviceId && d.uid == userId
            && d.deviceName is string && d.deviceName.size() > 0 && d.deviceName.size() <= 80
            && d.deviceType in ['android_phone', 'android_tablet', 'web', 'unknown']
            && d.platform in ['android', 'web']
            && d.publicKey is string && d.publicKey.size() >= 32 && d.publicKey.size() <= 512
            && d.keyFingerprint is string && d.keyFingerprint.matches('^[0-9a-f]{16,64}$')
            && d.authMethod in ['primary_login', 'qr_linked']
            && d.status in ['active', 'revoked']
            && d.online is bool
            && d.updatedAt == request.time;
        }
        function validActiveCreate(d) {
          return validDeviceFields(d)
            && d.status == 'active'
            && d.linkedAt == request.time && d.lastActiveAt == request.time
            && d.get('revokedAt', null) == null
            && (d.authMethod == 'primary_login' || (
                 d.authMethod == 'qr_linked'
                 && d.get('sessionId', null) is string
                 && getAfter(/databases/$(database)/documents/devicePairings/$(d.sessionId)).data.ownerUid == userId
                 && getAfter(/databases/$(database)/documents/devicePairings/$(d.sessionId)).data.requesterDeviceId == deviceId
               ));
        }

        // A device may always read its own record so it observes revocation immediately; listing requires active session.
        allow get: if request.auth != null && request.auth.uid == userId;
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && validActiveCreate(request.resource.data);
        allow update: if isOwner(userId) && validDeviceFields(request.resource.data) && (
          // 1. Heartbeat / activity update on an active device
          (resource.data.status == 'active' && request.resource.data.status == 'active'
            && dchanged().hasOnly(['deviceName', 'online', 'lastActiveAt', 'updatedAt', 'publicKey', 'keyFingerprint'])
            && request.resource.data.lastActiveAt == request.time)
          ||
          // 2. Revocation by an active owner device
          (resource.data.status == 'active' && request.resource.data.status == 'revoked'
            && dchanged().hasOnly(['status', 'online', 'revokedAt', 'revokedByDeviceId', 'updatedAt'])
            && request.resource.data.online == false
            && request.resource.data.revokedAt == request.time
            && request.resource.data.revokedByDeviceId is string
            && !isDeviceRevoked(userId, request.resource.data.revokedByDeviceId))
          ||
          // 3. Re-linking a device after fresh authentication
          (validActiveCreate(request.resource.data))
        );
        allow delete: if false;
      }
      match /chatPrefs/{cid} {
        allow read, write: if isOwner(userId);
      }
    }

    // ------------------------------------------------------------------ unique handles
    // Readable without auth so sign-up can check availability and sign-in can resolve an ID.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid()
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.username == name;
      allow update, delete: if false;
    }
    match /uniqueIds/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && id.matches('^[1-9][0-9]{9}$')
        && request.resource.data.keys().hasOnly(['uid', 'username']) && request.resource.data.uid == uid()
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.uniqueId10 == id
        && getAfter(/databases/$(database)/documents/users/$(uid())).data.username == request.resource.data.username;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ presence
    // Readable only if the owner's last-seen setting allows it, the reader shares their own last
    // seen (reciprocity) and the owner has not blocked the reader.
    match /presence/{userId} {
      allow get: if signedIn() && (uid() == userId || (
        visibilityAllows(userId, 'lastSeenVisibility')
        && userData(uid()).get('lastSeenVisibility', 'everyone') != 'nobody'
        && !hasBlocked(userId, uid())));
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['online', 'heartbeatAt', 'lastSeen'])
        && request.resource.data.online is bool;
      allow delete: if isOwner(userId);
    }

    // ------------------------------------------------------------------ conversations
    match /conversations/{cid} {
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function isAdmin() { return uid() in resource.data.get('admins', []); }

      function ownKeyOnly(field) {
        return !changed().hasAny([field]) || request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([uid()]);
      }

      // Sending a message / mutating one bumps preview + timestamps; receipts and typing are per user.
      function activityUpdate() {
        return changed().hasOnly(['lastMessage', 'lastMessageAt', 'updatedAt', 'typing', 'receipts'])
          && (!changed().hasAny(['lastMessage']) || request.resource.data.lastMessage.senderId == uid())
          && ownKeyOnly('typing')
          && ownKeyOnly('receipts');
      }

      function directSettingsUpdate() {
        return resource.data.type == 'direct'
          && changed().hasOnly(['disappearingSeconds', 'updatedAt', 'lastMessage', 'lastMessageAt', 'typing'])
          && validTimer(request.resource.data.get('disappearingSeconds', 0))
          && (!changed().hasAny(['lastMessage']) || request.resource.data.lastMessage.senderId == uid())
          && ownKeyOnly('typing');
      }

      function groupInfoUpdate() {
        return resource.data.type == 'group'
          && (isAdmin() || !resource.data.get('onlyAdminsCanEditInfo', true))
          && changed().hasOnly(['title', 'description', 'photoUrl', 'disappearingSeconds', 'updatedAt', 'lastMessage', 'lastMessageAt'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.get('description', '').size() <= 512
          && validTimer(request.resource.data.get('disappearingSeconds', 0))
          && (!changed().hasAny(['lastMessage']) || request.resource.data.lastMessage.senderId == uid());
      }

      // Admin-only: settings, adding/removing members, promoting/demoting admins.
      function groupAdminUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let removed = before.participants.toSet().difference(after.participants.toSet());
        return before.type == 'group' && isAdmin()
          && changed().hasOnly(['participants', 'admins', 'onlyAdminsCanSend', 'onlyAdminsCanEditInfo', 'updatedAt', 'lastMessage', 'lastMessageAt'])
          && after.participants.size() <= 256
          && after.admins.toSet().difference(after.participants.toSet()).size() == 0
          && after.admins.size() > 0
          && !(uid() in removed)
          && !(before.createdBy in removed)
          && (!(before.createdBy in before.admins) || before.createdBy in after.admins || uid() == before.createdBy)
          && (!changed().hasAny(['lastMessage']) || after.lastMessage.senderId == uid());
      }

      // Any member may leave. The last admin must hand admin rights to a remaining member.
      function leaveUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        return before.type == 'group'
          && changed().hasOnly(['participants', 'admins', 'typing', 'updatedAt', 'lastMessage', 'lastMessageAt'])
          && before.participants.toSet().difference(after.participants.toSet()) == [uid()].toSet()
          && after.participants.toSet().difference(before.participants.toSet()).size() == 0
          && !(uid() in after.admins)
          && (after.admins.toSet() == before.admins.toSet().difference([uid()].toSet())
              || (before.admins.toSet() == [uid()].toSet() && after.admins.size() == 1 && after.admins[0] in after.participants))
          && (after.participants.size() == 0 || after.admins.size() > 0)
          && (!changed().hasAny(['lastMessage']) || after.lastMessage.senderId == uid());
      }

      allow read: if signedIn() && uid() in resource.data.participants;

      allow create: if signedIn() && uid() in request.resource.data.participants && (
        // Direct chat: deterministic ID dm_<lowerUid>_<higherUid> prevents duplicates.
        (request.resource.data.type == 'direct'
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants[0] < request.resource.data.participants[1]
          && cid == 'dm_' + request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
          && request.resource.data.keys().hasOnly(['type', 'participants', 'lastMessage', 'lastMessageAt', 'updatedAt', 'typing', 'receipts', 'disappearingSeconds'])
          && !hasBlocked(request.resource.data.participants[0], uid())
          && !hasBlocked(request.resource.data.participants[1], uid()))
        ||
        // Group: the creator is the only initial admin.
        (request.resource.data.type == 'group'
          && request.resource.data.createdBy == uid()
          && request.resource.data.admins == [uid()]
          && request.resource.data.participants.size() >= 2 && request.resource.data.participants.size() <= 256
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
          && request.resource.data.get('description', '').size() <= 512
          && validTimer(request.resource.data.get('disappearingSeconds', 0))
          && request.resource.data.keys().hasOnly(['type', 'participants', 'admins', 'createdBy', 'createdAt', 'updatedAt', 'title', 'description',
               'photoUrl', 'onlyAdminsCanSend', 'onlyAdminsCanEditInfo', 'disappearingSeconds', 'lastMessageAt', 'lastMessage']))
      );

      allow update: if signedIn() && uid() in resource.data.participants
        && (activityUpdate() || directSettingsUpdate() || groupInfoUpdate() || groupAdminUpdate() || leaveUpdate());

      allow delete: if false;

      // ---------------------------------------------------------------- messages
      match /messages/{mid} {
        function mchanged() { return request.resource.data.diff(resource.data).affectedKeys(); }

        function validNewMessage() {
          let m = request.resource.data;
          let after = getAfter(convPath(cid)).data;
          return m.senderId == uid()
            // Participant after this write (new direct chats are created in the same batch), or a
            // system message written by a member who is leaving in the same batch.
            && (uid() in after.participants
                || (m.type == 'SYSTEM' && exists(convPath(cid)) && uid() in get(convPath(cid)).data.participants))
            && m.keys().hasOnly(['senderId', 'type', 'text', 'createdAt', 'updatedAt', 'clientCreatedAt', 'editedAt', 'deletedForEveryone',
                 'forwarded', 'mentions', 'reactions', 'replyTo', 'media', 'contact', 'location', 'poll', 'expiresAt', 'system'])
            && m.type in ['TEXT', 'IMAGE', 'VIDEO', 'AUDIO', 'DOCUMENT', 'LOCATION', 'POLL', 'CONTACT', 'SYSTEM']
            && m.text is string && m.text.size() <= 4096
            && m.createdAt == request.time && m.updatedAt == request.time
            && m.editedAt == null && m.deletedForEveryone == false
            && m.reactions.size() == 0
            && m.get('mentions', []).size() <= 50
            && (m.type != 'SYSTEM' || m.system.actor == uid())
            && (m.type == 'SYSTEM' || after.type != 'group' || !after.get('onlyAdminsCanSend', false) || uid() in after.get('admins', []))
            && (after.type != 'direct' || (!hasBlocked(after.participants[0], uid()) && !hasBlocked(after.participants[1], uid())))
            && (!('poll' in m) || (m.poll.votes.size() == 0 && m.poll.options.size() >= 2 && m.poll.options.size() <= 12))
            // A video's cover travels with the message as a small image.
            && (!('media' in m) || !('thumb' in m.media) || (m.media.thumb is bytes && m.media.thumb.size() <= 65536))
            && (m.get('expiresAt', null) == null || m.expiresAt > request.time);
        }

        // Authors may edit their own text messages for 15 minutes, at most 20 times. Every edit appends
        // the replaced text to `edits` (unchanged older entries, exactly the text being replaced, an
        // edit time inside the edit window), so the history cannot be rewritten. The history lives in
        // the message: only the chat's members can read it, and it is removed with the message.
        function validEditHistory() {
          let before = resource.data.get('edits', []);
          let after = request.resource.data.get('edits', null);
          let n = before.size();
          return !mchanged().hasAny(['edits']) || (
            after is list && after.size() == n + 1 && n < 20
            && (n == 0 || after[0:n] == before)
            && after[n].keys().hasOnly(['text', 'at'])
            && after[n].text == resource.data.text
            && after[n].at is timestamp
            && after[n].at > resource.data.createdAt - duration.value(10, 'm')
            && after[n].at < request.time + duration.value(10, 'm')
          );
        }

        function editByAuthor() {
          return resource.data.senderId == uid() && resource.data.type == 'TEXT' && resource.data.deletedForEveryone == false
            && mchanged().hasOnly(['text', 'editedAt', 'updatedAt', 'mentions', 'edits'])
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4096
            && request.resource.data.editedAt == request.time && request.resource.data.updatedAt == request.time
            && request.time < resource.data.createdAt + duration.value(15, 'm')
            && validEditHistory();
        }

        // Authors may delete for everyone within 48 hours; content (and its edit history) must actually be removed.
        function deleteForEveryone() {
          return resource.data.senderId == uid() && resource.data.deletedForEveryone == false
            && mchanged().hasOnly(['deletedForEveryone', 'text', 'media', 'replyTo', 'poll', 'contact', 'location', 'mentions', 'reactions', 'updatedAt', 'edits'])
            && request.resource.data.deletedForEveryone == true && request.resource.data.text == ''
            && !('media' in request.resource.data) && !('poll' in request.resource.data) && !('contact' in request.resource.data)
            && !('location' in request.resource.data) && !('replyTo' in request.resource.data) && !('edits' in request.resource.data)
            && request.resource.data.reactions.size() == 0
            && request.resource.data.updatedAt == request.time
            && request.time < resource.data.createdAt + duration.value(48, 'h');
        }

        // Each participant controls only their own reaction.
        function reactionUpdate() {
          return resource.data.deletedForEveryone == false
            && mchanged().hasOnly(['reactions', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([uid()])
            && (!(uid() in request.resource.data.reactions)
                || (request.resource.data.reactions[uid()] is string && request.resource.data.reactions[uid()].size() <= 16));
        }

        // Each participant controls only their own poll vote.
        function voteUpdate() {
          return resource.data.type == 'POLL' && resource.data.deletedForEveryone == false
            && mchanged().hasOnly(['poll', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.poll.diff(resource.data.poll).affectedKeys().hasOnly(['votes'])
            && request.resource.data.poll.votes.diff(resource.data.poll.votes).affectedKeys().hasOnly([uid()])
            && (!(uid() in request.resource.data.poll.votes)
                || (request.resource.data.poll.votes[uid()] is int && request.resource.data.poll.votes[uid()] >= 0
                    && request.resource.data.poll.votes[uid()] < resource.data.poll.options.size()));
        }

        allow read: if isParticipantNow(cid);
        allow create: if signedIn() && validNewMessage();
        allow update: if isParticipantNow(cid) && (editByAuthor() || deleteForEveryone() || reactionUpdate() || voteUpdate());
        // Expired disappearing messages may be cleaned up by participants (TTL also removes them).
        allow delete: if isParticipantNow(cid) && resource.data.get('expiresAt', null) != null && resource.data.expiresAt < request.time;
      }

      // ---------------------------------------------------------------- live location
      // One temporary live-location session: the sender's last point, when it was measured, when the
      // session ends and whether it was stopped. Only members of the chat can read it; only the
      // sender writes it. New points are refused after the end time (at most 8 hours after the
      // start) or once the session was stopped, so an ended session can never move again.
      match /live/{liveId} {
        function validPoint(d) {
          return d.lat is number && d.lat >= -90 && d.lat <= 90 && d.lng is number && d.lng >= -180 && d.lng <= 180
            && d.accuracy is number && d.accuracy >= 0 && d.accuracy < 100000
            && d.fixAt is timestamp && d.fixAt < request.time + duration.value(2, 'm');
        }

        allow read: if isParticipantNow(cid);

        allow create: if isParticipantNow(cid)
          && request.resource.data.keys().hasOnly(['ownerId', 'lat', 'lng', 'accuracy', 'fixAt', 'startedAt', 'updatedAt', 'expiresAt', 'endedAt'])
          && request.resource.data.ownerId == uid()
          && request.resource.data.startedAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.endedAt == null
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt < request.time + duration.value(485, 'm')
          && validPoint(request.resource.data);

        allow update: if signedIn() && resource.data.ownerId == uid() && resource.data.endedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lat', 'lng', 'accuracy', 'fixAt', 'updatedAt', 'endedAt'])
          && request.resource.data.updatedAt == request.time
          && validPoint(request.resource.data)
          && (request.resource.data.endedAt == null
                ? (request.time < resource.data.expiresAt && isParticipantNow(cid))
                : request.resource.data.endedAt == request.time);

        allow delete: if signedIn() && resource.data.ownerId == uid();
      }
    }

    // ------------------------------------------------------------------ statuses
    match /statuses/{sid} {
      allow get: if signedIn() && (resource.data.ownerId == uid()
        || (uid() in resource.data.audience && resource.data.expiresAt > request.time && !hasBlocked(resource.data.ownerId, uid())));
      allow list: if signedIn() && (resource.data.ownerId == uid() || uid() in resource.data.audience);
      allow create: if signedIn() && request.resource.data.ownerId == uid()
        && request.resource.data.keys().hasOnly(['ownerId', 'type', 'text', 'bgColor', 'font', 'media', 'createdAt', 'expiresAt', 'audience'])
        && request.resource.data.type in ['TEXT', 'IMAGE', 'VIDEO']
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && request.resource.data.audience is list && request.resource.data.audience.size() <= 500
        && (request.resource.data.text == null || (request.resource.data.text is string && request.resource.data.text.size() <= 700));
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == uid();

      match /views/{viewerId} {
        allow create: if signedIn() && viewerId == uid()
          && uid() in get(/databases/$(database)/documents/statuses/$(sid)).data.audience
          && request.resource.data.keys().hasOnly(['viewedAt']) && request.resource.data.viewedAt == request.time;
        allow read: if signedIn() && (viewerId == uid() || get(/databases/$(database)/documents/statuses/$(sid)).data.ownerId == uid());
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------ calls (WebRTC signalling)
    match /calls/{callId} {
      function cchanged() { return request.resource.data.diff(resource.data).affectedKeys(); }

      function calleeUpdate() {
        return resource.data.calleeId == uid() && (
          (resource.data.state == 'ringing' && request.resource.data.state == 'accepted' && cchanged().hasOnly(['state', 'answer', 'answeredAt']))
          || (resource.data.state == 'ringing' && request.resource.data.state in ['rejected', 'busy', 'failed'] && cchanged().hasOnly(['state', 'endedAt', 'endedBy']))
          || (resource.data.state == 'accepted' && request.resource.data.state in ['ended', 'failed'] && cchanged().hasOnly(['state', 'endedAt', 'endedBy']))
        );
      }

      function callerUpdate() {
        return resource.data.callerId == uid() && (
          (resource.data.state == 'ringing' && request.resource.data.state in ['cancelled', 'missed', 'failed'] && cchanged().hasOnly(['state', 'endedAt', 'endedBy']))
          || (resource.data.state == 'accepted' && request.resource.data.state in ['ended', 'failed'] && cchanged().hasOnly(['state', 'endedAt', 'endedBy']))
        );
      }

      allow get: if signedIn() && (resource.data.callerId == uid() || resource.data.calleeId == uid());
      allow list: if signedIn() && resource.data.calleeId == uid();
      allow create: if signedIn()
        && request.resource.data.callerId == uid() && request.resource.data.calleeId != uid()
        && request.resource.data.keys().hasOnly(['callerId', 'calleeId', 'video', 'state', 'offer', 'createdAt'])
        && request.resource.data.state == 'ringing' && request.resource.data.video is bool
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.calleeId))
        && !hasBlocked(request.resource.data.calleeId, uid());
      allow update: if signedIn() && (calleeUpdate() || callerUpdate());
      allow delete: if false;

      match /candidates/{candidateId} {
        function call() { return get(/databases/$(database)/documents/calls/$(callId)).data; }
        allow read: if signedIn() && (call().callerId == uid() || call().calleeId == uid());
        allow create: if signedIn() && request.resource.data.from == uid()
          && (call().callerId == uid() || call().calleeId == uid())
          && request.resource.data.keys().hasOnly(['from', 'candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt']);
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------ abuse reports (write-only)
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid()
        && request.resource.data.keys().hasOnly(['reporterId', 'targetUserId', 'conversationId', 'messageIds', 'reason', 'createdAt'])
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500
        && request.resource.data.messageIds is list && request.resource.data.messageIds.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ------------------------------------------------------------------ built-in media store
    // Used for photos, voice notes, videos, documents, statuses and profile/group photos whenever
    // the project has no usable Cloud Storage bucket (see MediaRefs.kt). A file is a metadata
    // document plus numbered chunks of at most 512 KB (64 chunks, i.e. 32 MB, at most).
    // Like Storage objects, media can be read by signed-in users who know its random ID, which
    // only appears in documents the reader is already allowed to see; it can never be listed.
    // Only the uploader can write or delete it.
    match /media/{mediaId} {
      function validMediaId() { return mediaId.matches('^[A-Za-z0-9_-]{8,64}$'); }
      function mediaOwnedByMe() { return resource == null || resource.data.owner == uid(); }

      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && validMediaId() && mediaOwnedByMe()
        && request.resource.data.keys().hasOnly(['owner', 'mime', 'size', 'chunks', 'createdAt'])
        && request.resource.data.owner == uid()
        && request.resource.data.mime is string && request.resource.data.mime.size() <= 128
        && request.resource.data['size'] is int && request.resource.data['size'] > 0 && request.resource.data['size'] <= 33554432
        && request.resource.data.chunks is int && request.resource.data.chunks > 0 && request.resource.data.chunks <= 64
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.owner == uid();

      match /chunks/{index} {
        function parent() { return get(/databases/$(database)/documents/media/$(mediaId)).data; }

        allow get: if signedIn();
        allow list: if false;
        allow create, update: if signedIn()
          && (resource == null || resource.data.owner == uid())
          && index.matches('^[0-9]{1,2}$')
          && request.resource.data.keys().hasOnly(['owner', 'data'])
          && request.resource.data.owner == uid()
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 524288
          && parent().owner == uid() && int(index) < parent().chunks;
        allow delete: if signedIn() && resource.data.owner == uid();
      }
    }

    // ------------------------------------------------------------------ device pairing sessions
    // Short-lived (~2 min) QR pairing sessions with one-time consumption and cryptographic proof.
    match /devicePairings/{sessionId} {
      function validSessionId() { return sessionId.matches('^[A-Za-z0-9_-]{20,40}$'); }
      function pchanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function immutablePairingFieldsUnchanged() {
        return !pchanged().hasAny(['sessionId', 'requesterDeviceId', 'requesterDeviceName', 'requesterDeviceType',
          'requesterPlatform', 'requesterPublicKey', 'requesterKeyFingerprint', 'ephemeralPublicKey',
          'secretHash', 'codeChallenge', 'manualCodeHash', 'createdAt', 'expiresAt']);
      }
      function validCodeVerifierProof() {
        let proof = request.resource.data.get('codeVerifierProof', '');
        return proof is string && proof.size() >= 20 && proof.size() <= 48
          && hashing.sha256(proof.toUtf8()).toHexString().lower() == resource.data.codeChallenge;
      }
      function validSecretProof() {
        let proof = request.resource.data.get('secretProof', '');
        return proof is string && proof.size() >= 20 && proof.size() <= 64
          && hashing.sha256(proof.toUtf8()).toHexString().lower() == resource.data.secretHash;
      }

      allow get: if validSessionId();
      allow list: if false;

      allow create: if validSessionId()
        && request.resource.data.keys().hasOnly(['sessionId', 'status', 'requesterDeviceId', 'requesterDeviceName',
             'requesterDeviceType', 'requesterPlatform', 'requesterPublicKey', 'requesterKeyFingerprint',
             'ephemeralPublicKey', 'secretHash', 'codeChallenge', 'manualCodeHash', 'createdAt', 'updatedAt',
             'expiresAt', 'ownerUid', 'approvedByDeviceId', 'approvedAt', 'completedAt', 'consumed'])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.status == 'pending'
        && request.resource.data.consumed == false
        && request.resource.data.ownerUid == null
        && request.resource.data.approvedByDeviceId == null
        && request.resource.data.approvedAt == null
        && request.resource.data.completedAt == null
        && request.resource.data.requesterDeviceId is string && request.resource.data.requesterDeviceId.size() >= 8 && request.resource.data.requesterDeviceId.size() <= 64
        && request.resource.data.requesterDeviceName is string && request.resource.data.requesterDeviceName.size() > 0 && request.resource.data.requesterDeviceName.size() <= 80
        && request.resource.data.requesterDeviceType in ['android_phone', 'android_tablet', 'web', 'unknown']
        && request.resource.data.requesterPlatform in ['android', 'web']
        && request.resource.data.requesterPublicKey is string && request.resource.data.requesterPublicKey.size() >= 32 && request.resource.data.requesterPublicKey.size() <= 512
        && request.resource.data.requesterKeyFingerprint is string && request.resource.data.requesterKeyFingerprint.matches('^[0-9a-f]{16,64}$')
        && request.resource.data.ephemeralPublicKey is string && request.resource.data.ephemeralPublicKey.size() >= 32 && request.resource.data.ephemeralPublicKey.size() <= 512
        && request.resource.data.secretHash is string && request.resource.data.secretHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.codeChallenge is string && request.resource.data.codeChallenge.matches('^[0-9a-f]{64}$')
        && request.resource.data.manualCodeHash is string && request.resource.data.manualCodeHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(3, 'm');

      allow update: if validSessionId() && immutablePairingFieldsUnchanged() && (
        // 1. Authenticated account owner approves a pending, non-expired session after scanning QR / code
        (signedIn()
          && resource.data.status == 'pending' && resource.data.consumed == false && resource.data.ownerUid == null
          && request.time < resource.data.expiresAt
          && pchanged().hasOnly(['status', 'ownerUid', 'approvedByDeviceId', 'approvedAt', 'updatedAt', 'codeVerifierProof'])
          && request.resource.data.status == 'approved'
          && request.resource.data.ownerUid == uid()
          && request.resource.data.approvedByDeviceId is string && request.resource.data.approvedByDeviceId.size() >= 8
          && !isDeviceRevoked(uid(), request.resource.data.approvedByDeviceId)
          && request.resource.data.approvedAt == request.time && request.resource.data.updatedAt == request.time
          && validCodeVerifierProof()
          && exists(/databases/$(database)/documents/users/$(uid())))
        ||
        // 2. Authenticated account user rejects a pending session
        (signedIn()
          && resource.data.status == 'pending' && resource.data.consumed == false
          && request.time < resource.data.expiresAt
          && pchanged().hasOnly(['status', 'updatedAt', 'codeVerifierProof'])
          && request.resource.data.status == 'rejected'
          && request.resource.data.updatedAt == request.time
          && validCodeVerifierProof())
        ||
        // 3. Requesting device cancels or expires its own pending session by proving possession of sessionSecret
        (resource.data.status == 'pending' && resource.data.consumed == false
          && pchanged().hasOnly(['status', 'updatedAt', 'secretProof'])
          && request.resource.data.status in ['expired', 'revoked']
          && request.resource.data.updatedAt == request.time
          && validSecretProof())
        ||
        // 4. Requesting device completes one-time consumption of an approved, non-expired session
        (signedIn() && uid() == resource.data.ownerUid
          && resource.data.status == 'approved' && resource.data.consumed == false
          && request.time < resource.data.expiresAt
          && !isDeviceRevoked(resource.data.ownerUid, resource.data.approvedByDeviceId)
          && pchanged().hasOnly(['status', 'consumed', 'completedAt', 'updatedAt', 'secretProof', 'deviceSignature'])
          && request.resource.data.status == 'completed'
          && request.resource.data.consumed == true
          && request.resource.data.completedAt == request.time && request.resource.data.updatedAt == request.time
          && validSecretProof()
          && request.resource.data.deviceSignature is string && request.resource.data.deviceSignature.size() >= 32
          && request.resource.data.deviceSignature.size() <= 512)
      );

      allow delete: if false;

      // One-time ECDH-P256 AES-256-GCM sealed authentication envelope.
      match /exchange/{docId} {
        function parentSession() { return get(/databases/$(database)/documents/devicePairings/$(sessionId)).data; }
        function parentAfter() { return getAfter(/databases/$(database)/documents/devicePairings/$(sessionId)).data; }

        allow get: if docId == 'envelope'
          && parentSession().status == 'approved'
          && parentSession().consumed == false
          && request.time < parentSession().expiresAt;
        allow list: if false;
        allow create: if signedIn() && docId == 'envelope'
          && parentAfter().status == 'approved'
          && parentAfter().ownerUid == uid()
          && parentAfter().consumed == false
          && request.resource.data.keys().hasOnly(['approverEphemeralPublicKey', 'ivBase64Url', 'ciphertextBase64Url', 'createdAt'])
          && request.resource.data.approverEphemeralPublicKey is string && request.resource.data.approverEphemeralPublicKey.size() >= 32 && request.resource.data.approverEphemeralPublicKey.size() <= 512
          && request.resource.data.ivBase64Url is string && request.resource.data.ivBase64Url.size() >= 12 && request.resource.data.ivBase64Url.size() <= 32
          && request.resource.data.ciphertextBase64Url is string && request.resource.data.ciphertextBase64Url.size() >= 16 && request.resource.data.ciphertextBase64Url.size() <= 4096
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && parentSession().ownerUid == uid();
      }
    }

    // Manual pairing-code lookup (keyed by SHA-256 of normalized 8-character code; never listable).
    match /devicePairingCodes/{codeHash} {
      allow get: if signedIn() && codeHash.matches('^[0-9a-f]{64}$');
      allow list: if false;
      allow create: if codeHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['sessionId', 'codeVerifier', 'keyFingerprint', 'createdAt', 'expiresAt'])
        && request.resource.data.sessionId is string && request.resource.data.sessionId.matches('^[A-Za-z0-9_-]{20,40}$')
        && request.resource.data.codeVerifier is string && request.resource.data.codeVerifier.matches('^[A-Za-z0-9_-]{20,48}$')
        && request.resource.data.keyFingerprint is string && request.resource.data.keyFingerprint.matches('^[0-9a-f]{16,64}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(3, 'm')
        && getAfter(/databases/$(database)/documents/devicePairings/$(request.resource.data.sessionId)).data.manualCodeHash == codeHash;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ admin-managed config (e.g. TURN servers)
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
