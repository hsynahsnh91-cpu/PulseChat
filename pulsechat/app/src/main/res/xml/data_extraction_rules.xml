<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Only local chat history and non-sensitive preferences are backed up or
     transferred. Authentication sessions, push tokens, app-lock state and media caches are excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="pulsechat_database" />
        <include domain="database" path="pulsechat_database-wal" />
        <include domain="database" path="pulsechat_database-shm" />
        <include domain="sharedpref" path="pulse_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="pulsechat_database" />
        <include domain="database" path="pulsechat_database-wal" />
        <include domain="database" path="pulsechat_database-shm" />
        <include domain="sharedpref" path="pulse_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
