<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Only local chat history and non-sensitive preferences are backed up.
     Authentication sessions, push tokens, app-lock state and media caches are never backed up. -->
<full-backup-content>
    <include domain="database" path="pulsechat_database" />
    <include domain="database" path="pulsechat_database-wal" />
    <include domain="database" path="pulsechat_database-shm" />
    <include domain="sharedpref" path="pulse_prefs.xml" />
</full-backup-content>
